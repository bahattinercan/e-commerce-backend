# Kopyalayın: cp .env.example .env  (Windows: copy .env.example .env)

# MongoDB bağlantı adresi
MONGO_CONNECT=mongodb://127.0.0.1:27017/ecommerce

# JWT imzalama anahtarı (üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_TOKEN=buraya-uzun-rastgele-bir-anahtar-yazin

# Sunucu portu
PORT=4000

# Yüklenen görsellerin tam URL'ini üretmek için kullanılan host (port ayrıca eklenir)
HOST=http://localhost

# Bu API'ye istek atabilen frontend adresleri (virgülle ayrılmış).
# Üretimde kendi domain'lerini yaz: https://shop.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5199

# Login token'ının geçerlilik süresi (ör. 7d, 24h)
JWT_EXPIRES_IN=7d
